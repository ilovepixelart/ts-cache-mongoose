{
  "name": "ts-cache-mongoose",
  "version": "2.5.0",
  "description": "Cache plugin for mongoose Queries and Aggregate (in-memory, redis)",
  "author": "ilovepixelart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilovepixelart/ts-cache-mongoose.git"
  },
  "bugs": {
    "url": "https://github.com/ilovepixelart/ts-cache-mongoose/issues"
  },
  "homepage": "https://github.com/ilovepixelart/ts-cache-mongoose#readme",
  "keywords": [
    "backend",
    "mongo",
    "mongodb",
    "mongoose",
    "plugin",
    "schema",
    "db",
    "nosql",
    "ts",
    "typescript",
    "cache",
    "redis",
    "store",
    "memory",
    "ttl",
    "query",
    "aggregate"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./nest": {
      "require": {
        "types": "./dist/nest/index.d.cts",
        "default": "./dist/nest/index.cjs"
      },
      "import": {
        "types": "./dist/nest/index.d.mts",
        "default": "./dist/nest/index.mjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "nest": [
        "./dist/nest/index.d.cts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "biome": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write .",
    "lint:package": "publint --strict && attw --pack .",
    "test": "vitest run --coverage",
    "test:open": "vitest run --coverage && open-cli coverage/lcov-report/index.html",
    "clean": "rm -rf ./dist",
    "type:check": "tsc --noEmit",
    "type:check:tests": "tsc --noEmit -p tests/tsconfig.json",
    "build": "pkgroll --clean-dist && node scripts/cjs-export-types.ts dist/index.d.cts dist/nest/index.d.cts",
    "release": "npm install && npm run biome && npm run type:check && npm run type:check:tests && npm run build && np --no-publish"
  },
  "dependencies": {
    "ioredis": "5.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/testing": "12.5.1",
    "@types/node": "22.20.5",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "bson": "7.3.4",
    "fast-check": "4.10.2",
    "mongodb-memory-server": "11.3.0",
    "mongoose": "9.12.2",
    "open-cli": "9.0.0",
    "pkgroll": "2.29.1",
    "publint": "0.3.25",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0 < 13",
    "bson": ">=4.7.2 < 8",
    "mongoose": ">=6.6.0 < 10"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npm run type:check",
    "pre-push": "npm run biome"
  },
  "np": {
    "publish": false
  }
}
